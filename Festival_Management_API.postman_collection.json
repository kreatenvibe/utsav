    {
      "name": "Expected Donations",
      "description": "Pledges tied to a donor + festival. total_donated is computed by summing linked (non-deleted) donations, not stored. No DELETE endpoint yet (deferred).",
      "item": [
        {
          "name": "Create Expected Donation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"donor_id\": {{donorId}},\n  \"festival_id\": {{festivalId}},\n  \"expected_amount\": 5000,\n  \"year\": 2026,\n  \"purpose\": \"Ganesh Chaturthi sponsorship\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/expected-donations",
              "host": ["{{baseUrl}}"],
              "path": ["expected-donations"]
            },
            "description": "Requires organizer auth. `donor_id`, `festival_id`, `expected_amount`, and `year` are required; `purpose` is optional. `status` defaults to `open` and cannot be set on create."
          }
        },
        {
          "name": "List Expected Donations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/expected-donations?festival_id={{festivalId}}&donor_id={{donorId}}&status=open",
              "host": ["{{baseUrl}}"],
              "path": ["expected-donations"],
              "query": [
                { "key": "festival_id", "value": "{{festivalId}}", "description": "Optional filter" },
                { "key": "donor_id", "value": "{{donorId}}", "description": "Optional filter" },
                { "key": "status", "value": "open", "description": "Optional filter, 'open' or 'closed'" }
              ]
            },
            "description": "Public — no auth required. Each row includes a computed `total_donated` field. All query params are optional filters."
          }
        },
        {
          "name": "Get Expected Donation by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/expected-donations/{{expectedDonationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["expected-donations", "{{expectedDonationId}}"]
            },
            "description": "Public — no auth required. Includes computed `total_donated`. 404 if not found."
          }
        },
        {
          "name": "Update Expected Donation",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"expected_amount\": 6000,\n  \"status\": \"closed\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/expected-donations/{{expectedDonationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["expected-donations", "{{expectedDonationId}}"]
            },
            "description": "Requires organizer auth. Partial update. `status`, if sent, must be exactly 'open' or 'closed' (400 otherwise) — it is set explicitly, never auto-derived from totals."
          }
        }
      ]
    },
    {
      "name": "Donations",
      "description": "Actual money received. Amounts are immutable once created (never edited) — only new rows are added, and delete is a SOFT delete (deleted_at) so history is preserved.",
      "item": [
        {
          "name": "Create Donation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"donor_id\": {{donorId}},\n  \"expected_id\": {{expectedDonationId}},\n  \"amount\": 5000,\n  \"date\": \"2026-08-20\",\n  \"collected_by\": {{memberId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/donations",
              "host": ["{{baseUrl}}"],
              "path": ["donations"]
            },
            "description": "Requires organizer auth. `donor_id`, `amount`, and `date` (YYYY-MM-DD) are required. `expected_id` is optional — omit it for a walk-in donation not tied to any pledge. `collected_by` (member id) is also optional."
          }
        },
        {
          "name": "List Donations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/donations?donor_id={{donorId}}&expected_id={{expectedDonationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["donations"],
              "query": [
                { "key": "donor_id", "value": "{{donorId}}", "description": "Optional filter" },
                { "key": "expected_id", "value": "{{expectedDonationId}}", "description": "Optional filter" }
              ]
            },
            "description": "Public — no auth required. Excludes soft-deleted rows automatically."
          }
        },
        {
          "name": "Get Donation by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/donations/{{donationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["donations", "{{donationId}}"]
            },
            "description": "Public — no auth required. Returns 404 for a soft-deleted donation, same as if it never existed."
          }
        },
        {
          "name": "Delete Donation",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/donations/{{donationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["donations", "{{donationId}}"]
            },
            "description": "Requires organizer auth. This is a SOFT delete — sets `deleted_at`, the row and its `amount` are never actually removed or edited. Affects the linked expected_donation's `total_donated` and the festival's `current_balance` on next read. Returns 204 with no body."
          }
        }
      ]
    },
    {
      "name": "Expenses",
