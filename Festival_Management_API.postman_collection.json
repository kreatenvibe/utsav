{
  "info": {
    "name": "Festival Management API",
    "description": "Backend API for the community festival management app (donations, expenses, tasks, volunteers, multi-colony support). All GET routes are public; every POST/PUT/PATCH/DELETE route requires a JWT via `Authorization: Bearer {{token}}` (see the Auth folder to obtain one).\n\nSet the `baseUrl` and `token` collection variables before running requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "f3f1a6b0-6b1a-4b1a-9c1a-festivalmgmtapi"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "colonyId", "value": "1", "type": "string" },
    { "key": "festivalId", "value": "1", "type": "string" },
    { "key": "memberId", "value": "1", "type": "string" },
    { "key": "donorId", "value": "1", "type": "string" },
    { "key": "expectedDonationId", "value": "1", "type": "string" },
    { "key": "donationId", "value": "1", "type": "string" },
    { "key": "expenseId", "value": "1", "type": "string" },
    { "key": "expensePaymentId", "value": "1", "type": "string" },
    { "key": "taskId", "value": "1", "type": "string" },
    { "key": "taskAssignmentId", "value": "1", "type": "string" },
    { "key": "availabilityId", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Public endpoints — no Authorization header needed. Login here to get the JWT to put in the {{token}} variable for every other request.",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"priya.sharma@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Creates a new user. No auth required. There is no roles system yet — any registered user is effectively an \"organizer\" with full write access. Returns 201 with `{ user_id, email }` (password hash never included). Duplicate email returns 409."
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"priya.sharma@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "No auth required. Returns `{ token }` — a JWT valid for 7 days. Copy the token into the collection-level `token` variable so all other requests pick it up automatically. Wrong password and unknown email both return 401 with the same message (login intentionally doesn't leak which emails are registered)."
          }
        }
      ]
    },
    {
      "name": "Colonies",
      "description": "No DELETE endpoint exists for colonies yet — cascade behavior (what happens to festivals under a deleted colony) hasn't been decided, so deletion is deliberately deferred.",
      "item": [
        {
          "name": "Create Colony",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sunrise Colony\",\n  \"location\": \"Sector 12, Pune\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/colonies",
              "host": ["{{baseUrl}}"],
              "path": ["colonies"]
            },
            "description": "Requires organizer auth. Only `name` is required; `location` is optional."
          }
        },
        {
          "name": "List Colonies",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/colonies",
              "host": ["{{baseUrl}}"],
              "path": ["colonies"]
            },
            "description": "Public — no auth required. Returns all colonies ordered by colony_id."
          }
        },
        {
          "name": "Get Colony by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/colonies/{{colonyId}}",
              "host": ["{{baseUrl}}"],
              "path": ["colonies", "{{colonyId}}"]
            },
            "description": "Public — no auth required. 404 if the colony doesn't exist."
          }
        },
        {
          "name": "Update Colony",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sunrise Colony Phase 2\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/colonies/{{colonyId}}",
              "host": ["{{baseUrl}}"],
              "path": ["colonies", "{{colonyId}}"]
            },
            "description": "Requires organizer auth. Partial update — omit any field you don't want to change, it stays as-is (COALESCE semantics)."
          }
        }
      ]
    },
    {
      "name": "Festivals",
      "description": "current_balance is always computed on read (SUM of matched donations minus SUM of expense_payments) — it is never stored or accepted on PATCH. No DELETE endpoint yet (deferred, same reason as colonies).",
      "item": [
        {
          "name": "Create Festival",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"colony_id\": {{colonyId}},\n  \"name\": \"Ganesh Chaturthi\",\n  \"year\": 2026\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/festivals",
              "host": ["{{baseUrl}}"],
              "path": ["festivals"]
            },
            "description": "Requires organizer auth. `colony_id`, `name`, and `year` are all required; `colony_id` must reference an existing colony (400 if not)."
          }
        },
        {
          "name": "List Festivals",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/festivals?colony_id={{colonyId}}",
              "host": ["{{baseUrl}}"],
              "path": ["festivals"],
              "query": [
                { "key": "colony_id", "value": "{{colonyId}}", "description": "Optional filter" }
              ]
            },
            "description": "Public — no auth required. Each row includes a computed `current_balance` field. Optional `colony_id` query param filters to one colony."
          }
        },
        {
          "name": "Get Festival by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/festivals/{{festivalId}}",
              "host": ["{{baseUrl}}"],
              "path": ["festivals", "{{festivalId}}"]
            },
            "description": "Public — no auth required. Includes computed `current_balance`. 404 if not found."
          }
        },
        {
          "name": "Update Festival",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ganesh Chaturthi Mahotsav\",\n  \"year\": 2026\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/festivals/{{festivalId}}",
              "host": ["{{baseUrl}}"],
              "path": ["festivals", "{{festivalId}}"]
            },
            "description": "Requires organizer auth. Only `name` and `year` are updatable — `current_balance` is always derived and silently ignored if sent."
          }
        }
      ]
    },
